# 텍스트 파일 줄바꿈 정규화 (저장소에는 LF로 저장)
* text=auto

# ==================================================
# 크로스플랫폼 줄바꿈 고정
# 어느 OS에서 체크아웃하든 아래 파일들은 지정된 줄바꿈 유지
# ==================================================
# 셸 스크립트: LF 필수 (CRLF면 맥/리눅스에서 실행 불가)
*.sh text eol=lf
*.bash text eol=lf

# 윈도우 스크립트: CRLF 필요 (LF면 일부 환경에서 깨짐)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ==================================================
# Unity YAML 파일: 텍스트로 취급, 충돌 시 union 머지
# (union: 충돌 난 양쪽 내용을 모두 보존. 완벽한 머지가 아니므로
#  충돌 발생 시 Unity를 열어 파일 상태를 반드시 확인할 것)
# ==================================================
*.unity text merge=union
*.prefab text merge=union
*.asset text merge=union
*.controller text merge=union
*.anim text merge=union
*.overrideController text merge=union
*.mask text merge=union
*.mat text merge=union
*.physicMaterial text merge=union
*.physicsMaterial2D text merge=union
*.guiskin text merge=union
*.playable text merge=union
*.spriteatlas text merge=union
*.terrainlayer text merge=union
*.lighting text merge=union
*.meta text

